// use prisma-next
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.


model Game {
    id      Int @id @default(autoincrement()) 
    level   Level
    characterCoordinates CharacterCoordinate[] 

}



model CharacterCoordinate{
    id Int @id @default(autoincrement())
    character Character 
    gameId Int 
    game Game @relation(fields: [gameId], references : [id])
    xCord Float
    yCord Float
    @@unique([gameId,charachter])
}

enum Level{
    Easy
    Medium
    Hard
    God
}

enum Character{
    YellowWaldo
    Cat
    GirlWaldo
    StickWaldo
    GandalfWaldo
} 
